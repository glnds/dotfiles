# Cyberdream
background = 16181a
foreground = ffffff
selection-background = 3c4048
selection-foreground = ffffff
palette = 0=#16181a
palette = 1=#ff6e5e
palette = 2=#5eff6c
palette = 3=#f1ff5e
palette = 4=#5ea1ff
palette = 5=#bd5eff
palette = 6=#5ef1ff
palette = 7=#ffffff
palette = 8=#3c4048
palette = 9=#ff6e5e
palette = 10=#5eff6c
palette = 11=#f1ff5e
palette = 12=#5ea1ff
palette = 13=#bd5eff
palette = 14=#5ef1ff
palette = 15=#ffffff

font-family = MesloLGM Nerd Font
font-size = 14
adjust-cell-height = 2

maximize = true
window-padding-x = 4
window-padding-y = 4
macos-option-as-alt = true
# env -u TMUX: Ghostty launched from a tmux pane inherits $TMUX, tmux refuses to nest
command = /usr/bin/env -u TMUX /opt/homebrew/bin/tmux new-session -As main
scrollback-limit = 10000000

confirm-close-surface = false
quit-after-last-window-closed = true
window-save-state = never
copy-on-select = clipboard
macos-titlebar-style = hidden
mouse-hide-while-typing = true
font-thicken = true
bell-features = attention,title

keybind = cmd+shift+m=toggle_maximize
